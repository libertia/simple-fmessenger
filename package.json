{
  "name": "facebook-messenger-electron",
  "version": "0.2.0",
  "description": "Simple Electron wrappers for Facebook Messenger and Gather, built as two separate apps",
  "main": "apps/messenger.js",
  "scripts": {
    "start": "electron .",
    "start:messenger": "electron .",
    "start:gather": "electron apps/gather.js",
    "build:messenger:win": "electron-builder --config electron-builder.messenger.json --win",
    "build:messenger:mac": "electron-builder --config electron-builder.messenger.json --mac",
    "build:messenger:linux": "electron-builder --config electron-builder.messenger.json --linux -c.electronDist=node_modules/electron/dist",
    "build:gather:win": "electron-builder --config electron-builder.gather.json --win",
    "build:gather:mac": "electron-builder --config electron-builder.gather.json --mac",
    "build:gather:linux": "electron-builder --config electron-builder.gather.json --linux -c.electronDist=node_modules/electron/dist",
    "build:linux": "npm run build:messenger:linux && npm run build:gather:linux"
  },
  "keywords": [
    "electron",
    "facebook",
    "messenger"
  ],
  "author": "your-name",
  "email": "test@mail.com",
  "license": "MIT",
  "devDependencies": {
    "electron": "^43.7.5",
    "electron-builder": "^24.0.0"
  }
}
